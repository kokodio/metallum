{
  "schemaVersion": 1,
  "id": "metallum",
  "version": "${version}",
  "name": "Metallum",
  "description": "This is an PoC Metal backend for Minecraft on macOS",
  "authors": [
    "kokodio"
  ],
  "contact": {
    "homepage": "https://github.com/kokodio/metallum",
    "sources": "https://github.com/kokodio/metallum"
  },
  "license": "MIT",
  "icon": "assets/metallum/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.metallum.Metallum"
    ],
    "sodium:config_api_user": [
      "com.metallum.compat.sodium.MetallumSodiumConfig"
    ]
  },
  "mixins": [
    "metallum.mixins.json",
    "metallum.sodium.mixins.json",
    "metallum.distanthorizons.mixins.json",
    "metallum.shine.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3-",
    "java": ">=25"
  }
}
